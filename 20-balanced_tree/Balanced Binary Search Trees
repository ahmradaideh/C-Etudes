// tree_utils.c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct TreeNode {
    int value;
    struct TreeNode *left, *right;
} TreeNode;

static TreeNode *make_node(int value) {
    TreeNode *node = (TreeNode *)malloc(sizeof(TreeNode));
    if (!node) {
        perror("malloc");
        exit(1);
    }
    node->value = value;
    node->left = node->right = NULL;
    return node;
}

static int cmp_int(const void *a, const void *b) {
    int x = *(const int *)a;
    int y = *(const int *)b;
    return (x > y) - (x < y);
}

static TreeNode *build_from_sorted(const int *arr, int left, int right) {
    if (left > right)
        return NULL;

    int mid = left + (right - left) / 2;
    TreeNode *root = make_node(arr[mid]);
    root->left = build_from_sorted(arr, left, mid - 1);
    root->right = build_from_sorted(arr, mid + 1, right);
    return root;
}

TreeNode *build_balanced_bst(int *values, size_t n) {
    if (!values || n == 0)
        return NULL;

    int *copy = (int *)malloc(n * sizeof(int));
    if (!copy) {
        perror("malloc");
        exit(1);
    }

    memcpy(copy, values, n * sizeof(int));
    qsort(copy, n, sizeof(int), cmp_int);

    TreeNode *root = build_from_sorted(copy, 0, (int)n - 1);
    free(copy);
    return root;
}
